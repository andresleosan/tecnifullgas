{
  "name": "tecnifullgas-landing",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prerender.mjs && node scripts/check-seo.mjs && npm run check:behavior",
    "check:behavior": "node scripts/check-analytics.mjs && node scripts/check-media.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.55.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "postcss": "8.5.23",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "6.4.5"
  },
  "overrides": {
    "@babel/core@>=7 <8": "7.29.6",
    "baseline-browser-mapping@>=2 <3": "2.11.0",
    "brace-expansion@>=1 <2": "1.1.21",
    "browserslist@>=4 <5": "4.28.7",
    "js-yaml@>=4 <5": "4.3.2",
    "nanoid@>=3 <4": "3.3.18",
    "postcss@>=8 <9": "8.5.23",
    "postcss-selector-parser@>=6 <7": "6.1.5",
    "source-map-js@>=1 <2": "1.2.2"
  }
